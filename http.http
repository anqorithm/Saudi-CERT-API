# Set these to your deployed API Gateway stage URLs, e.g. https://<api-id>.execute-api.<region>.amazonaws.com/default
@get_alerts_base = https://<GET_ALERTS_API>/default
@get_alert_base = https://<GET_ALERT_API>/default

###
# Get Alerts - Fetch multiple alerts with optional query parameters
# Basic usage without query parameters
GET {{get_alerts_base}}/get_alerts

# Usage with query parameters
GET {{get_alerts_base}}/get_alerts?page=1&limit=5

# Fetching alerts based on specific attributes like title or severity
GET {{get_alerts_base}}/get_alerts?title=Weekly%20Vulnerability&severity=Critical

###
# Get Alert - Fetch a single alert by its ID
# Replace <ALERT_ID> with the actual ID of the alert
GET {{get_alert_base}}/get_alert?alert_id=<ALERT_ID>

# Example with a placeholder ID
GET {{get_alert_base}}/get_alert?alert_id=5f50c31e8eabf80018e4b255
